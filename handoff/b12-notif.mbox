diff --git a/android/app/src/main/kotlin/io/github/stillemptynow/promax/ChatNotifications.kt b/android/app/src/main/kotlin/io/github/stillemptynow/promax/ChatNotifications.kt
index 393a210..6875a98 100644
--- a/android/app/src/main/kotlin/io/github/stillemptynow/promax/ChatNotifications.kt
+++ b/android/app/src/main/kotlin/io/github/stillemptynow/promax/ChatNotifications.kt
@@ -41,6 +41,12 @@ object ChatNotifications {
                     ProMaxNotifier(app).cancelChat(longArg(call.argument<Any>("chatId")))
                     result.success(null)
                 }
+                "pruneChat" -> {
+                    val chatId = longArg(call.argument<Any>("chatId"))
+                    val seen = longArg(call.argument<Any>("seen"))
+                    FkmChannel.post("pruneChat") { ProMaxNotifier(app).pruneChat(chatId, seen) }
+                    result.success(null)
+                }
                 "notifiedChats" -> result.success(ProMaxNotifier(app).notifiedChats())
                 else -> result.notImplemented()
             }
diff --git a/android/app/src/main/kotlin/io/github/stillemptynow/promax/FkmChannel.kt b/android/app/src/main/kotlin/io/github/stillemptynow/promax/FkmChannel.kt
index f9b766e..a56f382 100644
--- a/android/app/src/main/kotlin/io/github/stillemptynow/promax/FkmChannel.kt
+++ b/android/app/src/main/kotlin/io/github/stillemptynow/promax/FkmChannel.kt
@@ -137,6 +137,16 @@ object FkmChannel {
         return true
     }
 
+    fun post(tag: String, task: () -> Unit) {
+        worker.execute {
+            try {
+                task()
+            } catch (e: Exception) {
+                Log.w("Fkm", "$tag failed: ${e.message}")
+            }
+        }
+    }
+
     // Правка и удаление ничего не «доставляют» — счётчик они не трогают.
     private fun update(
         ctx: Context,
diff --git a/android/app/src/main/kotlin/io/github/stillemptynow/promax/ProMaxFcmService.kt b/android/app/src/main/kotlin/io/github/stillemptynow/promax/ProMaxFcmService.kt
index 7a31813..e0db5b6 100644
--- a/android/app/src/main/kotlin/io/github/stillemptynow/promax/ProMaxFcmService.kt
+++ b/android/app/src/main/kotlin/io/github/stillemptynow/promax/ProMaxFcmService.kt
@@ -124,6 +124,13 @@ class ProMaxNotifier(private val ctx: Context) {
 
         val active = activeIds()
         if (!active.contains(notifId)) clearChat(chatId)
+        val seen = data["seen"]?.toLongOrNull() ?: 0L
+        if (seen > 0L) {
+            if (ts <= seen) return
+            val history = loadHistory(chatId)
+            val unseen = history.filter { it.ts > seen }
+            if (unseen.size != history.size) saveHistory(chatId, unseen)
+        }
         val meta = ChatMeta(chatTitle, data["c"]?.toIntOrNull() ?: 0, chatTitle != senderName)
         saveMeta(chatId, meta)
         val history = appendHistory(
@@ -142,6 +149,23 @@ class ProMaxNotifier(private val ctx: Context) {
         syncSummary(notifId, null)
     }
 
+    fun pruneChat(chatId: Long, seen: Long) {
+        if (seen <= 0L) return
+        val history = loadHistory(chatId)
+        val unseen = history.filter { it.ts > seen }
+        if (unseen.size == history.size) return
+        if (unseen.isEmpty()) {
+            cancelChat(chatId)
+            return
+        }
+        saveHistory(chatId, unseen)
+        val notifId = notifIdOf(chatId)
+        if (!activeIds().contains(notifId)) return
+        val meta = loadMeta(chatId) ?: return
+        render(chatId, notifId, meta, unseen, alertOnce = true)
+        syncSummary(notifId, unseen.last())
+    }
+
     fun notifiedChats(): List<Long> {
         val active = activeIds()
         return pushPrefs().all.keys
